---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import FilterBar from '../../components/FilterBar.astro';
import HexTile from '../../components/HexTile.astro';
import FighterPanel from '../../components/FighterPanel.astro';
import RosterStrip from '../../components/RosterStrip.astro';
import logo from '../../assets/dbsz-logo.png';
import { useTranslations, getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const fighters = (await getCollection('fighters')).sort(
  (a, b) =>
    a.data.firstAppearance.year - b.data.firstAppearance.year || a.data.name.localeCompare(b.data.name, 'es'),
);

const fighterFighters = fighters.filter((f) => f.data.section !== 'outfits');
const outfitFighters = fighters.filter((f) => f.data.section === 'outfits');

const uniq = (values: string[]) => [...new Set(values)].sort((a, b) => a.localeCompare(b, 'es'));
const series = uniq(fighters.map((f) => f.data.series));
const sagas = uniq(fighters.map((f) => f.data.saga));
const roles = uniq(fighters.map((f) => f.data.role));
const statuses = uniq(fighters.map((f) => f.data.status));

const variantCount = fighters.reduce((acc, f) => acc + f.data.variants.length, 0);
const outfitsAndVariantsCount = outfitFighters.length + variantCount;

const title = t('meta.indexTitle') as string;
const description = (t('meta.indexDescription') as (count: number) => string)(fighters.length);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t('meta.jsonLdName'),
  description,
  numberOfItems: fighters.length,
  itemListElement: fighters.map((f, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: f.data.name,
    url: new URL(`/fighters/${f.id}/`, Astro.site).href,
  })),
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="relative overflow-hidden px-5 pt-14 pb-10 text-center">
    <Image
      src={logo}
      alt="DRAGON BALL: Sparking! ZERO"
      width={520}
      densities={[1, 2]}
      class="mx-auto w-80 sm:w-96"
    />

    <h1 class="title-slant mt-8 text-4xl leading-none text-white sm:text-6xl lg:text-7xl">
      <span class="text-ice">»</span> {t('hero.title')} <span class="text-ice">«</span>
    </h1>

    <p class="mx-auto mt-5 max-w-3xl text-sm leading-relaxed text-white/70 sm:text-base" set:html={t('hero.description')} />

    <dl class="mx-auto mt-8 flex max-w-2xl flex-wrap justify-center gap-x-10 gap-y-4">
      {
        [
          { k: t('stats.fighters') as string, v: fighters.length },
          { k: t('stats.variants') as string, v: outfitsAndVariantsCount },
        ].map((s) => (
          <div>
            <dd class="title-slant text-3xl text-ice">{s.v}</dd>
            <dt class="text-[10px] tracking-widest text-white/45 uppercase">{s.k}</dt>
          </div>
        ))
      }
    </dl>
  </section>

  {/* ----------------------------- Panal personajes ----------------------------- */}
  <section class="pt-4 pb-8" id="section-fighters">
    <h2 class="title-slant mb-6 text-center text-3xl text-white sm:text-5xl">
      <span class="text-ice">»</span> {t('filter.typeCharacters') as string} <span class="text-ice">«</span>
    </h2>
    <FilterBar series={series} sagas={sagas} roles={roles} statuses={statuses} total={fighterFighters.length} />
  </section>

  <section class="pb-20">
    <div id="hive" class="hive">
      {fighterFighters.map((fighter, i) => <HexTile fighter={fighter} index={i} />)}
    </div>

    <p id="hive-empty" hidden class="mt-10 text-center text-sm text-white/50" set:html={t('hive.empty')} />


  </section>

  {/* ----------------------------- Panal trajes ----------------------------- */}
  {
    outfitFighters.length > 0 && (
      <>
        <section class="pt-4 pb-8">
          <h2 class="title-slant mb-6 text-center text-3xl text-white sm:text-5xl">
            <span class="text-ice">»</span> {t('filter.typeOutfits') as string} <span class="text-ice">«</span>
          </h2>
        </section>

        <section class="pb-20" id="section-outfits">
          <div id="hive-outfits" class="hive">
            {outfitFighters.map((fighter, i) => <HexTile fighter={fighter} index={i} />)}
          </div>
        </section>
      </>
    )
  }

  {/* ---------------------------- Overlay ---------------------------- */}
  <div
    id="fighter-modal"
    hidden
    class="fixed inset-0 z-50 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-label={t('modal.close') as string}
  >
    <div
      data-backdrop
      class="fixed inset-0 backdrop-blur-[2px]"
      style="background:radial-gradient(125% 95% at 50% 0%, rgba(109,40,217,0.90), rgba(59,13,120,0.94) 55%, rgba(20,6,45,0.96))"
    ></div>
    <div class="relative mx-auto my-6 w-full max-w-7xl px-4 sm:my-10">
      <button
        type="button"
        data-close
        class="mb-3 ml-auto flex h-12 w-12 items-center justify-center text-ice drop-shadow-[0_0_10px_rgba(34,211,238,0.55)] transition hover:scale-110 hover:text-white"
        aria-label={t('modal.close') as string}
        >
          <svg viewBox="0 0 24 24" class="h-9 w-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <path d="M5 5 19 19M19 5 5 19" />
          </svg>
      </button>
      <div id="fighter-modal-content"></div>
      <RosterStrip fighters={fighters} />
    </div>
  </div>

  {
    fighters.map((fighter) => (
      <template data-panel-for={fighter.id}>
        <FighterPanel fighter={fighter} />
      </template>
    ))
  }
</Base>

<script>
  import { initRoster } from '../../scripts/roster';
  import { initLooks } from '../../scripts/looks';

  initRoster();
  initLooks();
</script>
