---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import StageTile from '@/components/StageTile.astro';
import StagePanel from '@/components/StagePanel.astro';
import StageStrip from '@/components/StageStrip.astro';
import { useTranslations, localeParams } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

export function getStaticPaths() {
  return localeParams().map(({ lang, param }) => ({
    params: { lang: param },
    props: { lang },
  }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stages = (await getCollection('stages')).sort(
  (a, b) => b.data.hype - a.data.hype || a.data.firstAppearance.year - b.data.firstAppearance.year,
);

const title = t('stages.metaTitle') as string;
const description = (t('stages.metaDesc') as (count: number) => string)(stages.length);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t('stages.jsonLdName'),
  description,
  numberOfItems: stages.length,
  itemListElement: stages.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.data.name,
    url: new URL(`/stages/${s.id}/`, Astro.site).href,
  })),
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="relative overflow-hidden px-5 pt-14 pb-8 text-center">
    <h1 class="title-slant text-4xl leading-none text-white sm:text-6xl lg:text-7xl">
      <span class="text-ice">»</span> {t('stages.heading')} <span class="text-ice">«</span>
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-white/70 sm:text-base" set:html={t('stages.description')} />
  </section>

  {/* ----------------------------- Grid ----------------------------- */}
  <section class="min-h-dvh pb-20">
    <div id="stage-grid" class="mx-auto grid max-w-6xl grid-cols-1 gap-4 px-5 sm:grid-cols-2 lg:grid-cols-3">
      {stages.map((stage, i) => <StageTile stage={stage} index={i} />)}
    </div>

    <p id="stage-empty" hidden class="mt-10 text-center text-sm text-white/50" set:html={t('stages.empty')} />

    <p class="mt-14 text-center text-xs text-white/40" set:html={t('stages.hint')} />
  </section>

  {/* ---------------------------- Overlay ---------------------------- */}
  <div
    id="stage-modal"
    hidden
    class="fixed inset-0 z-50 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-label={t('modal.close') as string}
  >
    <div
      data-backdrop
      class="fixed inset-0 backdrop-blur-[2px]"
      style="background:radial-gradient(125% 95% at 50% 0%, rgba(109,40,217,0.90), rgba(59,13,120,0.94) 55%, rgba(20,6,45,0.96))"
    ></div>
    <div class="relative mx-auto my-6 w-full max-w-7xl px-4 sm:my-10">
      <button
        type="button"
        data-stage-close
        class="mb-3 ml-auto flex h-12 w-12 items-center justify-center text-ice drop-shadow-[0_0_10px_rgba(34,211,238,0.55)] transition hover:scale-110 hover:text-white"
        aria-label={t('modal.close') as string}
      >
        <svg viewBox="0 0 24 24" class="h-9 w-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M5 5 19 19M19 5 5 19" />
        </svg>
      </button>
      <div id="stage-modal-content"></div>
      <StageStrip stages={stages} />
    </div>
  </div>

  {
    stages.map((stage) => (
      <template data-stage-panel-for={stage.id}>
        <StagePanel stage={stage} />
      </template>
    ))
  }
</Base>

<script>
  function initStages() {
    const grid = document.getElementById('stage-grid');
    const modal = document.getElementById('stage-modal');
    if (!grid || !modal) return;

    const content = document.getElementById('stage-modal-content')!;
    const home = location.pathname;

    /* --------------------- Tira de navegación entre escenarios --------------------- */
    const strip = document.getElementById('stage-strip');
    const stripBtns = strip ? Array.from(strip.querySelectorAll<HTMLButtonElement>('[data-strip-slug]')) : [];
    const prevBtn = document.getElementById('stage-strip-prev');
    const nextBtn = document.getElementById('stage-strip-next');

    function syncStrip(slug: string) {
      stripBtns.forEach((btn) => {
        const active = btn.dataset.stripSlug === slug;
        btn.setAttribute('aria-pressed', String(active));
        if (active) btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      });
    }

    function step(delta: number) {
      if (modal!.hidden || stripBtns.length === 0) return;
      const current = stripBtns.findIndex((btn) => btn.getAttribute('aria-pressed') === 'true');
      const from = current === -1 ? 0 : current;
      const next = (from + delta + stripBtns.length) % stripBtns.length;
      open(stripBtns[next].dataset.stripSlug!);
    }

    function open(slug: string) {
      const tpl = document.querySelector<HTMLTemplateElement>(`template[data-stage-panel-for="${slug}"]`);
      if (!tpl) return;
      content.replaceChildren(tpl.content.cloneNode(true));
      modal!.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      modal!.querySelector<HTMLButtonElement>('[data-stage-close]')?.focus();
      history.pushState({ stageSlug: slug }, '', `/stages/${slug}/`);
      syncStrip(slug);
    }

    function close() {
      if (modal!.hidden) return;
      modal!.hidden = true;
      content.replaceChildren();
      document.documentElement.style.overflow = '';
      if (history.state?.stageSlug) history.replaceState(null, '', home);
    }

    grid.addEventListener('click', (event) => {
      const tile = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-stage]');
      if (!tile || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      open(tile.dataset.slug!);
    });

    modal.addEventListener('click', (event) => {
      const el = event.target as HTMLElement;
      if (el.closest('[data-stage-close]') || el.hasAttribute('data-backdrop')) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });

    window.addEventListener('popstate', () => close());

    let dragged = false;

    stripBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.stripSlug;
        if (slug) open(slug);
      });
    });

    prevBtn?.addEventListener('click', () => step(-1));
    nextBtn?.addEventListener('click', () => step(1));

    document.addEventListener('keydown', (event) => {
      if (modal!.hidden) return;
      const target = event.target as HTMLElement;
      if (target.closest('input, textarea, select, [contenteditable]')) return;
      if (event.key === 'ArrowLeft') step(-1);
      if (event.key === 'ArrowRight') step(1);
    });

    // Rueda del ratón mueve el scroll horizontal (el eje vertical no tiene sentido aquí).
    strip?.addEventListener(
      'wheel',
      (event) => {
        if (event.deltaY === 0) return;
        event.preventDefault();
        strip.scrollLeft += event.deltaY;
      },
      { passive: false },
    );

    // Arrastre con el ratón (el táctil ya funciona nativo con overflow-x: auto).
    let pointerDown = false;
    let dragStartX = 0;
    let dragStartScroll = 0;

    strip?.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'touch') return;
      if ((event.target as HTMLElement).closest('[data-strip-slug]')) return;
      pointerDown = true;
      dragged = false;
      dragStartX = event.clientX;
      dragStartScroll = strip.scrollLeft;
      strip.setPointerCapture(event.pointerId);
    });

    strip?.addEventListener('pointermove', (event) => {
      if (!pointerDown) return;
      const delta = event.clientX - dragStartX;
      if (Math.abs(delta) > 6) dragged = true;
      strip.scrollLeft = dragStartScroll - delta;
    });

    const endDrag = () => {
      pointerDown = false;
    };
    strip?.addEventListener('pointerup', endDrag);
    strip?.addEventListener('pointercancel', endDrag);
  }

  initStages();
</script>
