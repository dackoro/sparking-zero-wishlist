---
import Base from '@/layouts/Base.astro';
import { useTranslations, useEnumLabel, localeParams, localePrefix } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

export function getStaticPaths() {
  return localeParams().map(({ lang, param }) => ({
    params: { lang: param },
    props: { lang },
  }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const el = useEnumLabel(lang);
const prefix = localePrefix(lang);

const ejemplo = `{
  "name": "Androide 21",
  "nameJa": "人造人間21号",
  "series": "Spin-off",
  "saga": "Dragon Ball FighterZ",
  "firstAppearance": {
    "year": 2018,
    "work": "Dragon Ball FighterZ",
    "medium": "Videojuego"
  },
  "role": "Antagonista",
  "status": "Wishlist",
  "accent": "#ec4899",
  "description": "Bio-androide creada por el Dr. Gero a partir del ADN de los guerreros más fuertes, incluyendo células de Majin Buu.",
  "variants": [
    {
      "name": "Forma Majin",
      "source": "FighterZ",
      "description": "Ojos amarillos, garras y sonrisa de depredadora: emerge cuando el hambre de absorber energía vital le gana a su lado racional, y ataca a amigos y enemigos por igual sin distinguirlos.",
      "image": "/fighters/androide-21-forma-maligna.webp",
      "portrait": "/fighters/androide-21-forma-maligna-portrait.webp",
      "scene": "/fighters/androide-21-forma-maligna-scene.webp",
      "accent": "#db2777"
    }
  ],
  "render": "/fighters/androide-21.webp",
  "portrait": "/fighters/androide-21-portrait.webp",
  "scene": "/fighters/androide-21-scene.webp",
  "tags": ["videojuego", "majin", "femenino"]
}`;

const ejemploTraje = `{
  "name": "Krilin",
  "nameJa": "クリリン",
  "series": "Dragon Ball Z",
  "saga": "Majin Buu",
  "firstAppearance": {
    "year": 1994,
    "work": "Dragon Ball Z, ep. 237",
    "medium": "Anime"
  },
  "role": "Secundario",
  "section": "outfits",
  "accent": "#ea580c",
  "description": "En el juego ya está Krilin con su look calvo clásico, pero falta esta skin con el pelo que se dejó crecer durante la saga de Majin Buu.",
  "portrait": "/fighters/krillin-portrait.webp",
  "render": "/fighters/krillin.webp",
  "scene": "/fighters/krillin-scene.webp",
  "tags": ["skin", "terricola", "buu", "humano"]
}`;

const campos: [string, string, string][] = [
  ['name', 'sí', el('name')],
  ['nameJa', 'no', el('nameJa')],
  ['series', 'sí', el('series')],
  ['saga', 'sí', el('saga')],
  ['firstAppearance.year', 'sí', el('firstAppearance.year')],
  ['firstAppearance.work', 'sí', el('firstAppearance.work')],
  ['firstAppearance.medium', 'sí', el('firstAppearance.medium')],
  ['role', 'sí', el('role')],
  ['status', 'no', el('status')],
  ['section', 'no', el('section')],
  ['accent', 'sí', el('accent')],
  ['description', 'sí', el('description')],
  ['variants', 'no', el('variants')],
  ['variants[].name', 'no', el('variants[].name')],
  ['variants[].source', 'no', el('variants[].source')],
  ['variants[].description', 'no', el('variants[].description')],
  ['variants[].image', 'no', el('variants[].image')],
  ['variants[].portrait', 'no', el('variants[].portrait')],
  ['variants[].scene', 'no', el('variants[].scene')],
  ['variants[].accent', 'no', el('variants[].accent')],
  ['render', 'no', el('render')],
  ['portrait', 'no', el('portrait')],
  ['scene', 'no', el('scene')],
  ['tags', 'no', el('tags')],
];

const title = t('contribute.title') as string;
const description = t('contribute.description') as string;
const fieldsHeader = t('contribute.fieldsHeader') as string[];
---

<Base title={title} description={description}>
  <div class="mx-auto max-w-4xl space-y-10 px-5 py-12">
    <header>
      <h1 class="title-slant text-4xl text-white sm:text-5xl">
        <span class="text-ice">»</span> {t('contribute.heading') as string} <span class="text-ice">«</span>
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-white/70" set:html={t('contribute.intro') as string} />
    </header>

    <section class="space-y-4">
      <h2 class="title-slant text-2xl text-ice">{t('contribute.steps') as string}</h2>
      <ol class="list-inside list-decimal space-y-2 text-sm text-white/75">
        <li set:html={t('contribute.step1') as string} />
        <li set:html={t('contribute.step2') as string} />
        <li set:html={t('contribute.step3') as string} />
        <li set:html={t('contribute.step4') as string} />
        <li set:html={t('contribute.step5') as string} />
      </ol>
    </section>

    <section class="space-y-4">
      <h2 class="title-slant text-2xl text-ice">{t('contribute.rules') as string}</h2>
      <ul class="list-inside list-disc space-y-2 text-sm text-white/75">
        <li set:html={t('contribute.rule1') as string} />
        <li set:html={t('contribute.rule2') as string} />
      </ul>
    </section>

    <section class="space-y-4">
      <h2 class="title-slant text-2xl text-ice">{t('contribute.sectionTitle') as string}</h2>
      <p class="text-sm leading-relaxed text-white/75" set:html={t('contribute.sectionDesc') as string} />
    </section>

    <section class="space-y-4">
      <h2 class="title-slant text-2xl text-ice">{t('contribute.variantsTitle') as string}</h2>
      <p class="text-sm leading-relaxed text-white/75" set:html={t('contribute.variantsDesc') as string} />
    </section>

    <section class="space-y-4">
      <h2 class="title-slant text-2xl text-ice">{t('contribute.fields') as string}</h2>
      <div class="overflow-x-auto rounded-lg border border-neon/25">
        <table class="w-full min-w-[36rem] text-left text-sm">
          <thead class="bg-white/5 text-[11px] tracking-widest text-white/50 uppercase">
            <tr>
              <th class="px-3 py-2">{fieldsHeader[0]}</th>
              <th class="px-3 py-2">{fieldsHeader[1]}</th>
              <th class="px-3 py-2">{fieldsHeader[2]}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {
              campos.map(([campo, req, desc]) => (
                <tr>
                  <td class="px-3 py-2 font-mono text-xs whitespace-nowrap text-ice">{campo}</td>
                  <td class="px-3 py-2 text-white/50">{el(req)}</td>
                  <td class="px-3 py-2 text-white/75">{desc}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="title-slant text-2xl text-ice">{t('contribute.example') as string}</h2>
      <pre
        class="overflow-x-auto rounded-lg border border-neon/25 bg-void/80 p-4 text-xs leading-relaxed text-white/80"><code>{ejemplo}</code></pre>
    </section>

    <section class="space-y-4">
      <h2 class="title-slant text-2xl text-ice">{t('contribute.exampleOutfit') as string}</h2>
      <pre
        class="overflow-x-auto rounded-lg border border-neon/25 bg-void/80 p-4 text-xs leading-relaxed text-white/80"><code>{ejemploTraje}</code></pre>
    </section>

    <a href={`${prefix}/`} class="title-slant inline-block rounded-md border border-neon/50 px-4 py-2 text-sm transition hover:border-ice hover:text-ice">
      {t('detail.back') as string}
    </a>
  </div>
</Base>
