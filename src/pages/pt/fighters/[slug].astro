---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import FighterPanel from '../../../components/FighterPanel.astro';
import { useTranslations, getLangFromUrl } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === 'es' ? '' : `/${lang}`;

export async function getStaticPaths() {
  const fighters = await getCollection('fighters');
  return fighters.map((fighter) => ({
    params: { slug: fighter.id },
    props: { fighter },
  }));
}

interface Props {
  fighter: CollectionEntry<'fighters'>;
}

const { fighter } = Astro.props;
const d = fighter.data;

const title = (t('detail.titleTemplate') as (name: string) => string)(d.name);
const description = (t('detail.descriptionTemplate') as (name: string, series: string, year: number, whyWanted: string) => string)(d.name, d.series, d.firstAppearance.year, d.whyWanted);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: (t('detail.jsonLdHeadline') as (name: string) => string)(d.name),
  description,
  about: {
    '@type': 'Person',
    name: d.name,
    alternateName: d.nameJa,
  },
  isPartOf: {
    '@type': 'CollectionPage',
    name: t('detail.jsonLdCollection') as string,
    url: new URL('/', Astro.site).href,
  },
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl px-4 py-10">
    <nav class="mb-5 text-xs text-white/50" aria-label={t('detail.breadcrumb') as string}>
      <a href={`${prefix}/`} class="transition hover:text-ice">{t('detail.breadcrumb') as string}</a>
      <span class="mx-2 text-white/25">/</span>
      <span class="text-white/70">{d.name}</span>
    </nav>

    <FighterPanel fighter={fighter} standalone />

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={`${prefix}/`}
        class="title-slant rounded-md border border-neon/50 px-4 py-2 text-sm text-white/80 transition hover:border-ice hover:text-ice"
      >
        {t('detail.back') as string}
      </a>
      <a
        href={`${prefix}/como-contribuir/`}
        class="title-slant rounded-md border border-white/20 px-4 py-2 text-sm text-white/60 transition hover:border-ice hover:text-ice"
      >
        {t('detail.edit') as string}
      </a>
    </div>
  </div>
</Base>

<script>
  import { initLooks } from '../../../scripts/looks';
  initLooks();
</script>
