---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import StageTile from '../../../components/StageTile.astro';
import StagePanel from '../../../components/StagePanel.astro';
import { useTranslations, getLangFromUrl } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stages = (await getCollection('stages')).sort(
  (a, b) => b.data.hype - a.data.hype || a.data.firstAppearance.year - b.data.firstAppearance.year,
);

const title = t('stages.metaTitle') as string;
const description = (t('stages.metaDesc') as (count: number) => string)(stages.length);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t('stages.jsonLdName'),
  description,
  numberOfItems: stages.length,
  itemListElement: stages.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.data.name,
    url: new URL(`/stages/${s.id}/`, Astro.site).href,
  })),
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="relative overflow-hidden px-5 pt-14 pb-8 text-center">
    <h1 class="title-slant text-4xl leading-none text-white sm:text-6xl lg:text-7xl">
      <span class="text-ice">»</span> {t('stages.heading')} <span class="text-ice">«</span>
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-white/70 sm:text-base" set:html={t('stages.description')} />
  </section>

  <section class="pb-20">
    <div id="stage-grid" class="mx-auto grid max-w-6xl grid-cols-1 gap-4 px-5 sm:grid-cols-2 lg:grid-cols-3">
      {stages.map((stage, i) => <StageTile stage={stage} index={i} />)}
    </div>

    <p id="stage-empty" hidden class="mt-10 text-center text-sm text-white/50" set:html={t('stages.empty')} />
    <p class="mt-14 text-center text-xs text-white/40" set:html={t('stages.hint')} />
  </section>

  <div
    id="stage-modal"
    hidden
    class="fixed inset-0 z-50 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-label={t('modal.close') as string}
  >
    <div data-backdrop class="fixed inset-0 bg-void/85 backdrop-blur-sm"></div>
    <div class="relative mx-auto my-6 w-full max-w-5xl px-4 sm:my-10">
      <button
        type="button"
        data-stage-close
        class="mb-3 ml-auto flex h-10 w-10 items-center justify-center rounded-full border border-white/25 text-2xl leading-none text-white/70 transition hover:border-ice hover:text-ice"
        aria-label={t('modal.close') as string}
      >
        ×
      </button>
      <div id="stage-modal-content"></div>
    </div>
  </div>

  {
    stages.map((stage) => (
      <template data-stage-panel-for={stage.id}>
        <StagePanel stage={stage} />
      </template>
    ))
  }
</Base>

<script>
  function initStages() {
    const grid = document.getElementById('stage-grid');
    const modal = document.getElementById('stage-modal');
    if (!grid || !modal) return;

    const content = document.getElementById('stage-modal-content')!;
    const home = location.pathname;

    function open(slug: string) {
      const tpl = document.querySelector<HTMLTemplateElement>(`template[data-stage-panel-for="${slug}"]`);
      if (!tpl) return;
      content.replaceChildren(tpl.content.cloneNode(true));
      modal!.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      modal!.querySelector<HTMLButtonElement>('[data-stage-close]')?.focus();
      history.pushState({ stageSlug: slug }, '', `/stages/${slug}/`);
    }

    function close() {
      if (modal!.hidden) return;
      modal!.hidden = true;
      content.replaceChildren();
      document.documentElement.style.overflow = '';
      if (history.state?.stageSlug) history.replaceState(null, '', home);
    }

    grid.addEventListener('click', (event) => {
      const tile = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-stage]');
      if (!tile || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      open(tile.dataset.slug!);
    });

    modal.addEventListener('click', (event) => {
      const el = event.target as HTMLElement;
      if (el.closest('[data-stage-close]') || el.hasAttribute('data-backdrop')) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });

    window.addEventListener('popstate', () => close());
  }

  initStages();
</script>
