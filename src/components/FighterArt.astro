---
/**
 * Render del personaje. Si la ficha trae imagen la usa; si no, dibuja un
 * placeholder generado con el color de acento para que la página se vea
 * completa aunque todavía no haya arte subido.
 */
interface Props {
  name: string;
  accent: string;
  image?: string;
  class?: string;
  eager?: boolean;
}

const { name, accent, image, class: className = '', eager = false } = Astro.props;

const initials = name
  .replace(/[^\p{L}\s]/gu, '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase())
  .join('');
---

{
  image ? (
    <img
      src={image}
      alt={`Render de ${name}`}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class={`h-full w-full object-contain ${className}`}
    />
  ) : (
    <svg
      viewBox="0 0 200 260"
      role="img"
      aria-label={`Arte pendiente de ${name}`}
      class={`h-full w-full ${className}`}
      style={`--accent:${accent}`}
    >
      <defs>
        <radialGradient id={`glow-${initials}-${accent.slice(1)}`} cx="50%" cy="42%" r="55%">
          <stop offset="0%" stop-color={accent} stop-opacity="0.55" />
          <stop offset="100%" stop-color={accent} stop-opacity="0" />
        </radialGradient>
      </defs>
      <circle cx="100" cy="112" r="86" fill={`url(#glow-${initials}-${accent.slice(1)})`} />
      {/* Silueta genérica de luchador */}
      <g fill={accent} opacity="0.85">
        <circle cx="100" cy="64" r="24" />
        <path d="M100 92c-26 0-44 16-48 42l-14 46 22 8 12-38 4 96h20l6-58 6 58h20l4-96 12 38 22-8-14-46c-4-26-22-42-48-42z" />
      </g>
      <text
        x="100"
        y="240"
        text-anchor="middle"
        font-size="26"
        font-weight="700"
        font-style="italic"
        fill="#ffffff"
        opacity="0.9"
      >
        {initials}
      </text>
    </svg>
  )
}
