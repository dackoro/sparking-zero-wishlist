---
import newsBg from '../assets/dbsz-news-background.jpg';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, useEnumLabel, getLangFromUrl, localize } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  stage: CollectionEntry<'stages'>;
  standalone?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const el = useEnumLabel(lang);

const { stage, standalone = false } = Astro.props;
const d = stage.data as Record<string, unknown>;
const L = (field: string) => localize(d, field, lang as Lang);
const Title = standalone ? 'h1' : 'h2';

const description = L('description') ?? '';
const stageName = localize(d, 'name', lang as Lang) ?? (d.name as string) ?? '';

const meta = [
  { label: t('panel.series') as string, value: el(d.series as string) },
  { label: t('panel.saga') as string, value: L('saga') ?? (d.saga as string) },
  { label: t('panel.firstAppearance') as string, value: `${d.firstAppearance?.year ?? '?'} · ${el((d.firstAppearance as any)?.medium as string)}` },
  { label: t('panel.work') as string, value: localize((d.firstAppearance as Record<string, unknown>) ?? {}, 'work', lang as Lang) ?? (d.firstAppearance as any)?.work as string ?? '' },
];
---

<article
  class="overflow-hidden rounded-xl border border-neon/40 shadow-[0_0_60px_-15px] shadow-neon/60"
  style={`--accent:${d.accent};background:linear-gradient(180deg, rgba(50,20,110,0.96), rgba(28,11,62,0.97) 55%, rgba(17,7,40,0.98))`}
  data-stage-panel
>
  {/* ---------- Cabecera visual ---------- */}
  <div class="relative aspect-[2072/1166] w-full overflow-hidden bg-abyss">
    {/* Fondo: escena */}
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image:url(${d.scene ?? newsBg.src})`}
      aria-hidden="true"
    >
    </div>

    {/* Gradiente solo abajo, muy sutil */}
    <div
      class="absolute inset-0"
      style={`background:linear-gradient(to top, #0b0616 0%, transparent 50%)`}
    >
    </div>

    <span
      class="absolute top-[4%] left-[3%] z-10 rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-widest uppercase"
      style={`background:${d.status === 'Ya es DLC' ? '#22d3ee' : d.accent};color:#0b0616`}
    >
      {el(d.status as string)}
    </span>
  </div>

  {/* ---------- Ficha ---------- */}
  <div class="grid gap-6 p-5 sm:p-7 lg:grid-cols-[1.4fr_1fr]">
    <div class="space-y-4">
      <Title class="title-slant text-3xl leading-none text-white sm:text-4xl">
        {stageName}
      </Title>
      <p class="text-sm leading-relaxed text-white/80">{description}</p>
    </div>

    <div class="space-y-5">
      <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
        {
          meta.map((m) => (
            <div class="min-w-0">
              <dt class="title-slant text-[10px] tracking-widest text-white/40">{m.label}</dt>
              <dd class="truncate text-white/85" title={m.value}>
                {m.value}
              </dd>
            </div>
          ))
        }
      </dl>

      {
        (d.tags as string[])?.length > 0 && (
          <ul class="flex flex-wrap gap-1.5">
            {(d.tags as string[]).map((t_: string) => (
              <li class="rounded bg-white/5 px-2 py-0.5 text-[10px] tracking-wide text-white/45">#{t_}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>
