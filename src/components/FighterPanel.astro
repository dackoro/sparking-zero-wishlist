---
import FighterArt from './FighterArt.astro';
import newsBg from '../assets/dbsz-news-background.jpg';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, useEnumLabel, getLangFromUrl, localize } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  fighter: CollectionEntry<'fighters'>;
  standalone?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const el = useEnumLabel(lang);

const { fighter, standalone = false } = Astro.props;
const d = fighter.data as Record<string, unknown>;
const Title = standalone ? 'h1' : 'h2';

const L = (field: string) => localize(d, field, lang as Lang);

const description = L('description') ?? '';
const fighterName = localize(d, 'name', lang as Lang) ?? (d.name as string) ?? '';

const looks = [
  {
    name: t('panel.defaultLook') as string,
    source: L('saga') ?? (d.saga as string),
    description,
    image: d.render as string | undefined,
    // Misma cara que sale en el panal del home.
    portrait: (d.portrait ?? d.render) as string | undefined,
    accent: d.accent as string,
    scene: d.scene as string | undefined,
  },
  ...((d.variants as any[]) ?? []).map((v: Record<string, unknown>) => ({
    name: localize(v, 'name', lang as Lang) ?? v.name as string ?? '',
    source: localize(v, 'source', lang as Lang) ?? v.source as string | undefined,
    description: localize(v, 'description', lang as Lang) ?? v.description as string | undefined,
    image: v.image as string | undefined,
    portrait: (v.portrait ?? v.image) as string | undefined,
    accent: v.accent as string | undefined,
    scene: v.scene as string | undefined,
  })),
];

const meta = [
  { label: t('panel.series') as string, value: el(d.series as string) },
  { label: t('panel.saga') as string, value: L('saga') ?? (d.saga as string) },
  { label: t('panel.firstAppearance') as string, value: `${d.firstAppearance?.year ?? '?'} · ${el((d.firstAppearance as any)?.medium as string)}` },
  { label: t('panel.work') as string, value: localize((d.firstAppearance as Record<string, unknown>) ?? {}, 'work', lang as Lang) ?? (d.firstAppearance as any)?.work as string ?? '' },
  { label: t('panel.role') as string, value: el(d.role as string) },
];
---

<article
  class="overflow-hidden rounded-xl border border-neon/40 shadow-[0_0_60px_-15px] shadow-neon/60"
  style={`--accent:${d.accent};background:linear-gradient(180deg, rgba(50,20,110,0.96), rgba(28,11,62,0.97) 55%, rgba(17,7,40,0.98))`}
  data-panel
  data-slug={fighter.id}
>
  {/* ---------- Cabecera visual ---------- */}
  <div class="relative aspect-[2072/1166] w-full overflow-hidden bg-abyss">
    {/* Fondo: escena, visible por la ventana derecha del marco */}
    {
      looks.map((look, i) => (
        <div
          class="absolute inset-0 bg-cover bg-center"
          data-bg-src={look.scene ?? newsBg.src}
          aria-hidden="true"
          data-look={i}
          hidden={i !== 0}
        >
        </div>
      ))
    }

    {/* Marco oficial: panel morado a la izquierda, transparente a la derecha */}
    <img
      src="/ui/shard-frame.webp"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 h-full w-full select-none"
      style="object-fit:fill"
      loading="lazy"
      decoding="async"
      width="2072"
      height="1166"
    />

    {/* Render transparente sobre el panel morado */}
    {
      looks.map((look, i) => (
        <div
          class="absolute inset-y-0 left-[2%] flex w-[36%] items-center justify-center py-[3%]"
          data-look={i}
          hidden={i !== 0}
        >
          <FighterArt name={fighterName} accent={look.accent ?? d.accent as string} image={look.image} eager={i === 0} />
        </div>
      ))
    }

    <span
      class="absolute top-[4%] left-[3%] z-10 rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-widest uppercase"
      style={`background:${d.status === 'Ya es DLC' ? '#22d3ee' : d.accent};color:#0b0616`}
    >
      {el(d.status as string)}
    </span>
  </div>

  {/* ---------- Ficha ---------- */}
  <div class="grid gap-6 p-5 sm:p-7 lg:grid-cols-[1.4fr_1fr]">
    <div class="space-y-4">
      <div>
        {
          looks.map((look, i) => (
            <div data-look={i} hidden={i !== 0}>
              <Title class="title-slant text-3xl leading-none text-white sm:text-4xl">
                {i === 0 ? fighterName : `${fighterName} · ${look.name}`}
              </Title>
            </div>
          ))
        }
        {d.nameJa && <p class="mt-1 text-sm text-white/40">{d.nameJa as string}</p>}
      </div>

      <p class="text-sm leading-relaxed text-white/80" data-look-desc>{description}</p>
    </div>

    <div class="space-y-5">
      <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
        {
          meta.map((m) => (
            <div class="min-w-0">
              <dt class="title-slant text-[10px] tracking-widest text-white/40">{m.label}</dt>
              <dd class="truncate text-white/85" title={m.value}>
                {m.value}
              </dd>
            </div>
          ))
        }
      </dl>

      {
        looks.length > 1 && (
          <div>
            <p class="title-slant mb-2 text-xs tracking-widest text-white/50">
              {t('panel.outfits') as string}
            </p>
            <div class="flex flex-wrap justify-center gap-3" role="group" aria-label={t('panel.outfits') as string}>
              {looks.map((look, i) => (
                <button
                  type="button"
                  data-look-btn={i}
                  data-desc={look.description ?? ''}
                  data-accent={look.accent ?? d.accent as string}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  class="variant-hex transition"
                  style={`--v-accent:${look.accent ?? d.accent}`}
                  title={look.name}
                >
                  <span class="variant-hex-inner">
                    {
                      look.portrait && (
                        <img
                          data-src={look.portrait}
                          alt=""
                          aria-hidden="true"
                          loading="lazy"
                          decoding="async"
                          width="300"
                          height="300"
                        />
                      )
                    }
                    <span class="variant-hex-label">
                      <span class="block text-[10px] leading-tight font-bold uppercase">{look.name}</span>
                      {look.source && <span class="block text-[9px] leading-none opacity-70">{look.source}</span>}
                    </span>
                  </span>
                </button>
              ))}
            </div>
          </div>
        )
      }

      {
        (d.tags as string[])?.length > 0 && (
          <ul class="flex flex-wrap gap-1.5">
            {(d.tags as string[]).map((t_: string) => (
              <li class="rounded bg-white/5 px-2 py-0.5 text-[10px] tracking-wide text-white/45">#{t_}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>

<style>
  /* El fondo de `.variant-hex` es el borde: `.variant-hex-inner` lo tapa
     dejando 3px visibles alrededor, igual que en el panal del home. */
  .variant-hex {
    --ring: color-mix(in srgb, var(--v-accent) 45%, #0b0616);
    position: relative;
    width: 98px;
    height: 113px;
    background: var(--ring);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    cursor: pointer;
  }
  .variant-hex[aria-pressed='true'],
  .variant-hex:hover {
    --ring: var(--v-accent);
    z-index: 2;
  }

  .variant-hex-inner {
    position: absolute;
    inset: 3px;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    background: #150a2b;
    overflow: hidden;
  }

  .variant-hex-inner img {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: top;
    /* Las no activas se ven apagadas para que resalte la seleccionada. */
    filter: grayscale(0.45) brightness(0.7);
    transition: filter 0.18s ease;
  }
  .variant-hex[aria-pressed='true'] .variant-hex-inner img,
  .variant-hex:hover .variant-hex-inner img {
    filter: none;
  }

  /* Degradado inferior para que el nombre se lea sobre la foto. */
  .variant-hex-label {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 14px 6px 10px;
    text-align: center;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
    background: linear-gradient(to top, rgba(11, 6, 22, 0.95), rgba(11, 6, 22, 0));
  }
</style>
