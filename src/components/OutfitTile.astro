---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, getLangFromUrl } from '../i18n/utils';

interface OutfitEntry {
  parentSlug: string;
  parentName: string;
  parentAccent: string;
  variantName: string;
  variantSource?: string;
  variantAccent?: string;
}

interface Props {
  outfit: OutfitEntry;
  index?: number;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { outfit, index = 0 } = Astro.props;
const accent = outfit.variantAccent ?? outfit.parentAccent;
---

<a
  id={`outfit-${outfit.parentSlug}-${index}`}
  href={`/fighters/${outfit.parentSlug}/`}
  class="hex-cell hive-anim group"
  style={`--accent:${accent}; animation-delay:${Math.min(index * 18, 600)}ms`}
  data-hex-outfit
  data-slug={outfit.parentSlug}
  data-name={outfit.variantName.toLowerCase()}
  data-parent={outfit.parentName.toLowerCase()}
>
  <span class="hex-inner" style={`background:linear-gradient(165deg, ${accent}44, #150a2b 60%)`}>

    <span class="absolute inset-0 flex items-center justify-center pt-[4%]">
      <svg viewBox="0 0 200 260" role="img" class="h-full w-full scale-110">
        <defs>
          <radialGradient id={`glow-outfit-${outfit.parentSlug}-${index}`} cx="50%" cy="42%" r="55%">
            <stop offset="0%" stop-color={accent} stop-opacity="0.55" />
            <stop offset="100%" stop-color={accent} stop-opacity="0" />
          </radialGradient>
        </defs>
        <circle cx="100" cy="120" r="80" fill={`url(#glow-outfit-${outfit.parentSlug}-${index})`} />
        {/* icono de camiseta/capa */}
        <g fill={accent} opacity="0.9">
          <path d="M100 60c-18 0-32 8-36 20l-12 30 20 6 8-28 4 80h18l4-50 4 50h18l4-80 8 28 20-6-12-30c-4-12-18-20-36-20z" />
          <rect x="70" y="150" width="16" height="40" rx="2" transform="rotate(-12 70 150)" />
          <rect x="114" y="150" width="16" height="40" rx="2" transform="rotate(12 114 150)" />
        </g>
      </svg>
    </span>

    <span
      class="absolute inset-x-0 bottom-[14%] px-1 text-center"
    >
      <span class="block text-[10px] leading-tight font-bold text-white uppercase drop-shadow-[0_1px_2px_rgba(0,0,0,0.9)] sm:text-[11px]">
        {outfit.variantName}
      </span>
      <span class="mt-0.5 block text-[9px] leading-none text-white/40">
        {(t('outfitTile.from') as (p: string) => string)(outfit.parentName)}
      </span>
    </span>

    <span
      class="absolute inset-0 bg-white/0 transition group-hover:bg-white/10"
      aria-hidden="true"
    />
  </span>
</a>
