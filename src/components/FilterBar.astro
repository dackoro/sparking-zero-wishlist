---
import { useTranslations, useEnumLabel, getLangFromUrl } from '../i18n/utils';

interface Props {
  series: string[];
  sagas: string[];
  roles: string[];
  statuses: string[];
  total: number;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const el = useEnumLabel(lang);

const { series, sagas, roles, statuses, total } = Astro.props;

const selectClass =
  'w-full rounded-md border border-neon/40 bg-abyss/80 px-3 py-2 text-sm text-white/90 outline-none transition focus:border-ice focus:ring-1 focus:ring-ice';
const labelClass = 'title-slant mb-1 block text-[10px] tracking-widest text-white/45';
---

<form id="filtros" class="mx-auto max-w-6xl scroll-mt-24 px-5" autocomplete="off">
  <div class="rounded-xl border border-neon/25 bg-void/70 p-4 backdrop-blur-sm sm:p-5">
    <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
      <div class="col-span-2 md:col-span-3 lg:col-span-2">
        <label class={labelClass} for="f-q">{t('filter.search') as string}</label>
        <input
          id="f-q"
          name="q"
          type="search"
          placeholder={t('filter.searchPlaceholder') as string}
          class={selectClass}
          enterkeyhint="search"
        />
      </div>

      <div>
        <label class={labelClass} for="f-series">{t('filter.series') as string}</label>
        <select id="f-series" name="series" class={selectClass}>
          <option value="">{t('filter.allSeries') as string}</option>
          {series.map((s) => <option value={s}>{el(s)}</option>)}
        </select>
      </div>

      <div>
        <label class={labelClass} for="f-role">{t('filter.role') as string}</label>
        <select id="f-role" name="role" class={selectClass}>
          <option value="">{t('filter.anyRole') as string}</option>
          {roles.map((r) => <option value={r}>{el(r)}</option>)}
        </select>
      </div>

      <div>
        <label class={labelClass} for="f-sort">{t('filter.sort') as string}</label>
        <select id="f-sort" name="sort" class={selectClass}>
          <option value="year-asc">{t('filter.sortYearAsc') as string}</option>
          <option value="year-desc">{t('filter.sortYearDesc') as string}</option>
          <option value="series">{t('filter.sortSeries') as string}</option>
          <option value="name-asc">{t('filter.sortNameAsc') as string}</option>
        </select>
      </div>

      <div class="col-span-2 md:col-span-2 lg:col-span-4">
        <label class={labelClass} for="f-saga">{t('filter.saga') as string}</label>
        <select id="f-saga" name="saga" class={selectClass}>
          <option value="">{t('filter.allSagas') as string}</option>
          {sagas.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>

      <div>
        <label class={labelClass} for="f-status">{t('filter.status') as string}</label>
        <select id="f-status" name="status" class={selectClass}>
          <option value="">{t('filter.allStatuses') as string}</option>
          {statuses.map((s) => <option value={s}>{el(s)}</option>)}
        </select>
      </div>

      <div class="flex items-end">
        <button
          type="reset"
          class="title-slant w-full rounded-md border border-white/20 px-3 py-2 text-sm text-white/70 transition hover:border-ice hover:text-ice"
        >
          {t('filter.clear') as string}
        </button>
      </div>
    </div>

    <p class="mt-3 text-xs text-white/50" aria-live="polite">
      <strong class="text-ice" id="hive-count">{total}</strong>
      <span data-filter-count-suffix hidden data-text={JSON.stringify(t('filter.countOf'))}></span>
      {(t('filter.countOf') as (obj: { total: number }) => string)({ total })}
    </p>
  </div>
</form>
