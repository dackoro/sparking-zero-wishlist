---
import { useTranslations, useEnumLabel, getLangFromUrl } from '../i18n/utils';

interface Props {
  series: string[];
  sagas: string[];
  roles: string[];
  statuses: string[];
  total: number;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const el = useEnumLabel(lang);

const { series, sagas, roles, statuses, total } = Astro.props;

const selectClass =
  'w-full rounded-md border border-neon/40 bg-abyss/80 px-3 py-2 text-sm text-white/90 outline-none transition focus:border-ice focus:ring-1 focus:ring-ice';
const labelClass = 'title-slant mb-1 block text-[10px] tracking-widest text-white/45';
---

<form id="filtros" class="mx-auto max-w-4xl scroll-mt-24 px-5" autocomplete="off">
  <div class="filter-disclosure rounded-xl border border-neon/25 bg-void/70 backdrop-blur-sm">
    <div class="flex items-center gap-3 px-4 sm:px-5">
      <button
        type="button"
        id="filter-toggle"
        class="flex min-w-0 flex-1 items-center py-3 text-left text-sm text-white/80 transition hover:text-white"
        aria-expanded="false"
        aria-controls="filter-content"
      >
        <span class="title-slant text-ice">{t('filter.toggle') as string}</span>
      </button>

      <button
        type="button"
        id="filter-chevron-toggle"
        class="filter-chevron shrink-0 p-1 text-ice transition hover:text-white"
        aria-label={t('filter.toggle') as string}
        aria-expanded="false"
        aria-controls="filter-content"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" role="presentation">
          <path d="M5 8.5 12 15.5 19 8.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

    </div>

    <div id="filter-content" class="filter-content">
      <div class="border-t border-neon/20 p-4 sm:p-5">
      <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
      <div class="col-span-2 md:col-span-3 lg:col-span-2">
        <label class={labelClass} for="f-q">{t('filter.search') as string}</label>
        <input
          id="f-q"
          name="q"
          type="search"
          placeholder={t('filter.searchPlaceholder') as string}
          class={selectClass}
          enterkeyhint="search"
        />
      </div>

      <div>
        <label class={labelClass} for="f-series">{t('filter.series') as string}</label>
        <select id="f-series" name="series" class={selectClass}>
          <option value="">{t('filter.allSeries') as string}</option>
          {series.map((s) => <option value={s}>{el(s)}</option>)}
        </select>
      </div>

      <div>
        <label class={labelClass} for="f-role">{t('filter.role') as string}</label>
        <select id="f-role" name="role" class={selectClass}>
          <option value="">{t('filter.anyRole') as string}</option>
          {roles.map((r) => <option value={r}>{el(r)}</option>)}
        </select>
      </div>

      <div>
        <label class={labelClass} for="f-sort">{t('filter.sort') as string}</label>
        <select id="f-sort" name="sort" class={selectClass}>
          <option value="year-asc">{t('filter.sortYearAsc') as string}</option>
          <option value="year-desc">{t('filter.sortYearDesc') as string}</option>
          <option value="series">{t('filter.sortSeries') as string}</option>
          <option value="name-asc">{t('filter.sortNameAsc') as string}</option>
        </select>
      </div>

      <div class="col-span-2 md:col-span-2 lg:col-span-4">
        <label class={labelClass} for="f-saga">{t('filter.saga') as string}</label>
        <select id="f-saga" name="saga" class={selectClass}>
          <option value="">{t('filter.allSagas') as string}</option>
          {sagas.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>

      <div>
        <label class={labelClass} for="f-status">{t('filter.status') as string}</label>
        <select id="f-status" name="status" class={selectClass}>
          <option value="">{t('filter.allStatuses') as string}</option>
          {statuses.map((s) => <option value={s}>{el(s)}</option>)}
        </select>
      </div>

      <div class="flex items-end">
        <button
          type="reset"
          class="title-slant w-full rounded-md border border-white/20 px-3 py-2 text-sm text-white/70 transition hover:border-ice hover:text-ice"
        >
          {t('filter.clear') as string}
        </button>
      </div>

      <div class="col-span-2 flex items-end md:col-span-2 lg:col-span-2">
        <label class="name-toggle flex w-full cursor-pointer items-center justify-between gap-3 rounded-md border border-ice/35 bg-abyss/40 px-3 py-2 text-xs text-ice transition hover:border-ice hover:text-white">
          <span id="f-show-names-label">{t('filter.showNames') as string}</span>
          <input
            id="f-show-names"
            type="checkbox"
            class="sr-only"
            data-show-label={t('filter.showNames') as string}
            data-hide-label={t('filter.hideNames') as string}
          />
          <span class="name-toggle-track" aria-hidden="true"><span></span></span>
        </label>
      </div>
      </div>

      <p class="mt-3 text-xs text-white/50" aria-live="polite">
        <strong class="text-ice" id="hive-count">{total}</strong>
        <span data-filter-count-suffix hidden data-text={JSON.stringify(t('filter.countOf'))}></span>
        {(t('filter.countOf') as (obj: { total: number }) => string)({ total })}
      </p>
      </div>
    </div>
  </div>
</form>

<script>
  const filterDisclosure = document.querySelector<HTMLElement>('.filter-disclosure');
  const filterToggle = document.getElementById('filter-toggle');
  const filterChevronToggle = document.getElementById('filter-chevron-toggle');

  [filterToggle, filterChevronToggle].forEach((control) => control?.addEventListener('click', () => {
    if (!filterDisclosure) return;
    const open = filterDisclosure.dataset.open === 'true';
    filterDisclosure.dataset.open = String(!open);
    filterToggle.setAttribute('aria-expanded', String(!open));
    filterChevronToggle?.setAttribute('aria-expanded', String(!open));
  }));

  const showNames = document.getElementById('f-show-names') as HTMLInputElement | null;
  const showNamesLabel = document.getElementById('f-show-names-label');
  const namesPreferenceKey = 'dbsz-show-names';

  const applyNamesVisibility = (visible: boolean) => {
    if (!showNames) return;
    showNames.checked = visible;
    document.querySelectorAll<HTMLElement>('.hive').forEach((hive) => {
      hive.classList.toggle('names-hidden', !visible);
    });
    if (showNamesLabel) {
      showNamesLabel.textContent = visible
        ? showNames.dataset.hideLabel ?? ''
        : showNames.dataset.showLabel ?? '';
    }
  };

  let savedNamesPreference = false;
  try {
    savedNamesPreference = window.localStorage.getItem(namesPreferenceKey) === 'true';
  } catch {
    savedNamesPreference = false;
  }
  applyNamesVisibility(savedNamesPreference);

  showNames?.addEventListener('change', () => {
    const visible = showNames.checked;
    try {
      window.localStorage.setItem(namesPreferenceKey, String(visible));
    } catch {
      // La preferencia permanece solo en memoria si el navegador bloquea storage.
    }
    applyNamesVisibility(visible);
  });
</script>
