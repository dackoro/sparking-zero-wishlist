---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/dbsz-logo.png';
import bgSection from '../assets/dbsz-bg-section.jpg';

interface Props {
  title: string;
  description: string;
  /** Ruta absoluta de la imagen para redes sociales */
  ogImage?: string;
  /** JSON-LD ya serializable */
  jsonLd?: Record<string, unknown>;
}

const { title, description, ogImage = '/og-default.jpg', jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0b0616" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DBSZ Wishlist" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body class="min-h-screen">
    <div
      class="pointer-events-none fixed inset-0 -z-10 bg-cover bg-center bg-fixed opacity-25"
      style={`background-image:url(${bgSection.src})`}
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none fixed inset-0 -z-10 bg-gradient-to-b from-void/85 via-abyss/80 to-void"
      aria-hidden="true"
    >
    </div>

    <header
      class="sticky top-0 z-40 border-b border-neon/20 bg-void/80 backdrop-blur-md supports-[backdrop-filter]:bg-void/60"
    >
      <nav class="mx-auto flex max-w-6xl items-center gap-6 px-5 py-3" aria-label="Principal">
        <a href="/" class="shrink-0" aria-label="Inicio">
          <Image src={logo} alt="Dragon Ball Sparking! Zero" width={132} densities={[1, 2]} class="h-9 w-auto" />
        </a>
        <ul class="title-slant flex flex-1 items-center gap-5 text-sm tracking-wide">
          <li><a href="/" class="transition hover:text-ice">Roster deseado</a></li>
          <li><a href="/#filtros" class="transition hover:text-ice">Filtros</a></li>
          <li>
            <a href="/como-contribuir" class="transition hover:text-ice">Contribuir</a>
          </li>
        </ul>
        <a
          href="https://github.com/tu-usuario/dbsz-sparking-wishlist"
          rel="noopener noreferrer nofollow"
          target="_blank"
          class="title-slant rounded-full border border-ice/60 bg-ice/10 px-4 py-1.5 text-xs text-ice transition hover:bg-ice hover:text-void"
        >
          Añadir personaje
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-neon/20 bg-void/70 py-10">
      <div class="mx-auto max-w-6xl space-y-3 px-5 text-sm text-white/50">
        <p class="title-slant text-base text-white/80">Proyecto de fans, sin ánimo de lucro.</p>
        <p>
          Dragon Ball y DRAGON BALL: Sparking! ZERO son marcas de Bird Studio / Shueisha, Toei Animation y
          Bandai Namco Entertainment. Esta página no está afiliada ni respaldada por ellos: es una lista de
          deseos hecha por la comunidad.
        </p>
        <p>
          El código y los datos son abiertos. ¿Falta alguien? Abre un pull request con su ficha.
        </p>
      </div>
    </footer>
  </body>
</html>
